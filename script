local noclipConn, flyConn

local function enableNoclip()
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

local function disableNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
end

local function lockPhysics()
    if hum then hum:ChangeState(Enum.HumanoidStateType.Physics) end
    if hum then hum.Sit = false end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function pinAt(pos, duration)
    if flyConn then flyConn:Disconnect() end
    flyConn = RunService.Heartbeat:Connect(function()
        if not hrp or not hum then return end
        lockPhysics()
        hrp.CFrame = CFrame.new(pos)
    end)
    task.wait(duration)
    flyConn:Disconnect()
    flyConn = nil
end

local function flyTo(target, speed)
    local dist = (hrp.Position - target).Magnitude
    local duration = math.max(dist / speed, 0.3)
    local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, info, {CFrame = CFrame.new(target)})
    local moveConn = RunService.Heartbeat:Connect(function()
        lockPhysics()
    end)
    tween:Play()
    tween.Completed:Wait()
    moveConn:Disconnect()
end

local function click(x, y, delay)
    VirtualInputManager:SendMouseMoveEvent(x, y, game)
    task.wait(0.08)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.06)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    task.wait(delay or 0.5)
end

local function doRun()
    resolveChar()
    enableNoclip()

    -- pin in place, fire all clicks (spawn boat + launch)
    local startPin = hrp.Position + Vector3.new(0, 15, 0)
    flyConn = RunService.Heartbeat:Connect(function()
        if not hrp or not hum then return end
        lockPhysics()
        hrp.CFrame = CFrame.new(startPin)
    end)
    for _, c in ipairs(menuClicks) do
        click(c.x, c.y, 0.6)
    end
    flyConn:Disconnect(); flyConn = nil
    task.wait(2)

    -- fly each checkpoint
    for _, wp in ipairs(waypoints) do
        if not getgenv().BABFT_Active then break end
        flyTo(wp.pos, 100)
        pinAt(wp.pos, wp.hover)
    end

    -- claim gold click
    click(goldClick.x, goldClick.y, 0.5)
    task.wait(2)

    -- reset character, wait for respawn
    local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if h then h.Health = 0 end
    task.wait(6)
end

local function runFarm()
    while getgenv().BABFT_Active do
        pcall(doRun)
        if getgenv().BABFT_Active then
            task.wait(1)
            resolveChar()
            enableNoclip()
        end
    end
    disableNoclip()
end

